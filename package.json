{
  "name": "trust-modeler",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && venv/bin/uvicorn app.main:app",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron electron/main.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\""
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "jsx": "^0.9.89"
  }
}
